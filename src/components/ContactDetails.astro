---
import { site } from '../data/site';
import { t, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const ui = t(Astro.props.lang);
---

<dl class="contact-details">
  <dt>{ui.mail}</dt>
  <dd>
    {
      site.emails.map((e) => (
        <a href={`mailto:${e}`}>{e}</a>
      ))
    }
  </dd>
  <dt>{ui.tel}</dt>
  <dd><a href={site.phoneHref}>{site.phone}</a></dd>
</dl>

<style>
  .contact-details {
    display: grid;
    grid-template-columns: auto 1fr;
    column-gap: 1.25em;
    row-gap: 0.75em;
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.6;
  }

  dt {
    color: var(--ink-soft);
  }

  dd {
    margin: 0;
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  a {
    text-decoration: none;
    overflow-wrap: anywhere;
    padding: 2px 0;
  }

  a:hover {
    text-decoration: underline;
  }

  @media (max-width: 479px) {
    .contact-details {
      grid-template-columns: 1fr;
      row-gap: 0.15em;
      font-size: 0.8125rem;
    }
    dt {
      font-size: 0.6875rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }
    dd + dt {
      margin-top: 0.75em;
    }
  }
</style>
