---
// Portada: réplica de la primera página del PDF + índice de proyectos.
import Base from '../layouts/Base.astro';
import ContactDetails from '../components/ContactDetails.astro';
import WorkIndex from '../components/WorkIndex.astro';
import { routes, t, type Lang } from '../i18n/ui';
import { site } from '../data/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const ui = t(lang);
---

<Base lang={lang} altUrl={routes.home[lang === 'es' ? 'en' : 'es']} current="home">
  <div class="cover">
    <section class="sheet cover__top d-no-rails" data-draw>
      <div class="cell c-first no-t m-short" data-draw></div>
      <div class="cell no-t m-hide" data-draw></div>
      <div class="cell c-last no-t m-hide" data-draw></div>

      <div class="cell c-first m-hide" data-draw></div>
      <div class="cell cover__name v-center" data-draw>
        <h1 class="serif">
          <span class="cover__title">{site.name}</span>
          <span class="cover__subtitle">{ui.subtitle}</span>
        </h1>
      </div>
      <div class="cell c-last m-hide" data-draw></div>

      <div class="cell c-first m-hide" data-draw></div>
      <div class="cell m-hide" data-draw></div>
      <div class="cell c-last m-hide" data-draw></div>
    </section>

    <section class="sheet cover__bottom d-no-rails" data-draw>
      <div class="cell c-first m-hide" data-draw></div>
      <div class="cell cover__contact" data-draw>
        <ContactDetails lang={lang} />
      </div>
      <div class="cell c-last m-hide" data-draw></div>

      <div class="cell c-first m-short" data-draw></div>
      <div class="cell m-hide" data-draw></div>
      <div class="cell c-last m-hide" data-draw></div>
    </section>
  </div>

  <WorkIndex lang={lang} />
</Base>

<style>
  .cover {
    display: grid;
    grid-template-rows: 3fr 2fr;
    min-height: calc(100svh - var(--header-h));
  }

  .cover__top {
    grid-template-columns: 1fr 4.2fr 1fr;
    grid-template-rows: 1.6fr auto 1fr;
  }

  .cover__bottom {
    grid-template-columns: 1fr 1.2fr 1.05fr;
    grid-template-rows: auto 1fr;
  }

  .cover__name {
    text-align: center;
    padding-top: clamp(20px, 3vw, 44px);
    padding-bottom: clamp(20px, 3vw, 44px);
  }

  .cover__name h1 {
    font-weight: 400;
    line-height: 1.12;
  }

  .cover__title {
    display: block;
    font-size: clamp(2rem, 4.6vw, 4.6rem);
    text-wrap: balance;
  }

  .cover__subtitle {
    display: block;
    margin-top: 0.5em;
    font-size: clamp(1.05rem, 2vw, 1.9rem);
  }

  @media (max-width: 767px) {
    .cover {
      display: block;
      min-height: 0;
    }
    .cover__top > .cell.m-short {
      min-height: 22svh;
    }
    .cover__name {
      text-align: left;
      padding-top: 40px;
      padding-bottom: 40px;
    }
    .cover__bottom > .cell.m-short {
      min-height: 72px;
    }
  }
</style>
